--- !u!114 &2247205970413987306
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8222211471984596934}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.Robotics.UrdfImporter::Unity.Robotics.UrdfImporter.UrdfPlugin
  PluginText: "<gazebo reference=\"head_front_camera_color_frame\">\n  <sensor name=\"head_front_camera_frame_sensor\"
    type=\"depth\">\n    <always_on>true</always_on>\n    <visualize>true</visualize>\n   
    <update_rate>30.0</update_rate>\n    <topic>head_front_camera</topic>\n    <gz_frame_id>head_front_camera_color_frame</gz_frame_id>\n   
    <camera>\n      <horizontal_fov>1.0995574287564276</horizontal_fov>\n      <image>\n       
    <format>B8G8R8</format>\n        <width>640</width>\n        <height>480</height>\n     
    </image>\n      <clip>\n        <near>0.3</near>\n        <far>8.0</far>\n     
    </clip>\n      <distortion>\n        <k1>0.00000001</k1>\n        <k2>0.00000001</k2>\n       
    <k3>0.00000001</k3>\n        <p1>0.00000001</p1>\n        <p2>0.00000001</p2>\n     
    </distortion>\n    </camera>\n    <plugin filename=\"libgazebo_ros_camera.so\"
    name=\"head_front_camera_frame_controller\">\n      <camera_name>head_front_camera</camera_name>\n     
    <ros>\n        <!-- <namespace>${name}</namespace>-->\n        <remapping>head_front_camera/image_raw:=head_front_camera/rgb/image_raw</remapping>\n       
    <remapping>head_front_camera/camera_info:=head_front_camera/rgb/camera_info</remapping>\n       
    <remapping>head_front_camera/depth/image_raw:=head_front_camera/depth/image_raw</remapping>\n       
    <remapping>head_front_camera/depth/camera_info:=head_front_camera/depth/camera_info</remapping>\n       
    <remapping>head_front_camera/points:=head_front_camera/depth/points</remapping>\n     
    </ros>\n      <frame_name>head_front_camera_color_optical_frame</frame_name>\n     
    <min_depth>0.3</min_depth>\n      <max_depth>8.0</max_depth>\n    </plugin>\n 
    </sensor>\n</gazebo>"
--- !u!114 &6307453532291733565
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8222211471984596934}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.Robotics.UrdfImporter::Unity.Robotics.UrdfImporter.UrdfPlugin
  PluginText: "<ros2_control name=\"ros2_control_tiago_system\" type=\"system\">\n 
    <!-- Execution env config -->\n  <hardware>\n    <plugin>robot_control/RobotControl</plugin>\n 
    </hardware>\n  <joint name=\"wheel_front_right_joint\">\n    <command_interface
    name=\"velocity\" />\n    <state_interface name=\"position\" />\n  </joint>\n 
    <transmission name=\"wheel_front_right_trans\">\n    <plugin>transmission_interface/SimpleTransmission</plugin>\n   
    <actuator name=\"wheel_front_right_actuator\" role=\"actuator1\" />\n    <joint
    name=\"wheel_front_right_joint\" role=\"joint1\">\n      <mechanical_reduction>1.0</mechanical_reduction>\n   
    </joint>\n  </transmission>\n  <joint name=\"wheel_front_left_joint\">\n    <command_interface
    name=\"velocity\" />\n    <state_interface name=\"position\" />\n  </joint>\n 
    <transmission name=\"wheel_front_left_trans\">\n    <plugin>transmission_interface/SimpleTransmission</plugin>\n   
    <actuator name=\"wheel_front_left_actuator\" role=\"actuator1\" />\n    <joint
    name=\"wheel_front_left_joint\" role=\"joint1\">\n      <mechanical_reduction>1.0</mechanical_reduction>\n   
    </joint>\n  </transmission>\n  <joint name=\"wheel_rear_right_joint\">\n    <command_interface
    name=\"velocity\" />\n    <state_interface name=\"position\" />\n  </joint>\n 
    <transmission name=\"wheel_rear_right_trans\">\n    <plugin>transmission_interface/SimpleTransmission</plugin>\n   
    <actuator name=\"wheel_rear_right_actuator\" role=\"actuator1\" />\n    <joint
    name=\"wheel_rear_right_joint\" role=\"joint1\">\n      <mechanical_reduction>1.0</mechanical_reduction>\n   
    </joint>\n  </transmission>\n  <joint name=\"wheel_rear_left_joint\">\n    <command_interface
    name=\"velocity\" />\n    <state_interface name=\"position\" />\n  </joint>\n 
    <transmission name=\"wheel_rear_left_trans\">\n    <plugin>transmission_interface/SimpleTransmission</plugin>\n   
    <actuator name=\"wheel_rear_left_actuator\" role=\"actuator1\" />\n    <joint
    name=\"wheel_rear_left_joint\" role=\"joint1\">\n      <mechanical_reduction>1.0</mechanical_reduction>\n   
    </joint>\n  </transmission>\n  <joint name=\"torso_lift_joint\">\n    <command_interface
    name=\"position\" />\n    <state_interface name=\"position\" />\n    <state_interface
    name=\"velocity\" />\n    <state_interface name=\"effort\" />\n  </joint>\n 
    <transmission name=\"torso_lift_trans\">\n    <plugin>transmission_interface/SimpleTransmission</plugin>\n   
    <actuator name=\"torso_lift_actuator\" role=\"actuator1\" />\n    <joint name=\"torso_lift_joint\"
    role=\"joint1\">\n      <mechanical_reduction>1.0</mechanical_reduction>\n     
    <offset>0.0</offset>\n    </joint>\n  </transmission>\n  <joint name=\"arm_1_joint\">\n   
    <command_interface name=\"position\" />\n    <command_interface name=\"velocity\"
    />\n    <command_interface name=\"effort\" />\n    <state_interface name=\"position\"
    />\n    <state_interface name=\"velocity\" />\n    <state_interface name=\"effort\"
    />\n  </joint>\n  <transmission name=\"arm_1_trans\">\n    <plugin>transmission_interface/SimpleTransmission</plugin>\n   
    <actuator name=\"arm_1_actuator\" role=\"actuator1\" />\n    <joint name=\"arm_1_joint\"
    role=\"joint1\">\n      <mechanical_reduction>1.0</mechanical_reduction>\n     
    <offset>0.0</offset>\n    </joint>\n  </transmission>\n  <joint name=\"arm_2_joint\">\n   
    <command_interface name=\"position\" />\n    <command_interface name=\"velocity\"
    />\n    <command_interface name=\"effort\" />\n    <state_interface name=\"position\"
    />\n    <state_interface name=\"velocity\" />\n    <state_interface name=\"effort\"
    />\n  </joint>\n  <transmission name=\"arm_2_trans\">\n    <plugin>transmission_interface/SimpleTransmission</plugin>\n   
    <actuator name=\"arm_2_actuator\" role=\"actuator1\" />\n    <joint name=\"arm_2_joint\"
    role=\"joint1\">\n      <mechanical_reduction>1.0</mechanical_reduction>\n     
    <offset>0.0</offset>\n    </joint>\n  </transmission>\n  <joint name=\"arm_3_joint\">\n   
    <command_interface name=\"position\" />\n    <command_interface name=\"velocity\"
    />\n    <command_interface name=\"effort\" />\n    <state_interface name=\"position\"
    />\n    <state_interface name=\"velocity\" />\n    <state_interface name=\"effort\"
    />\n  </joint>\n  <transmission name=\"arm_3_trans\">\n    <plugin>transmission_interface/SimpleTransmission</plugin>\n   
    <actuator name=\"arm_3_actuator\" role=\"actuator1\" />\n    <joint name=\"arm_3_joint\"
    role=\"joint1\">\n      <mechanical_reduction>1.0</mechanical_reduction>\n     
    <offset>0.0</offset>\n    </joint>\n  </transmission>\n  <joint name=\"arm_4_joint\">\n   
    <command_interface name=\"position\" />\n    <command_interface name=\"velocity\"
    />\n    <command_interface name=\"effort\" />\n    <state_interface name=\"position\"
    />\n    <state_interface name=\"velocity\" />\n    <state_interface name=\"effort\"
    />\n  </joint>\n  <transmission name=\"arm_4_trans\">\n    <plugin>transmission_interface/SimpleTransmission</plugin>\n   
    <actuator name=\"arm_4_actuator\" role=\"actuator1\" />\n    <joint name=\"arm_4_joint\"
    role=\"joint1\">\n      <mechanical_reduction>1.0</mechanical_reduction>\n     
    <offset>0.0</offset>\n    </joint>\n  </transmission>\n  <joint name=\"arm_5_joint\">\n   
    <command_interface name=\"position\" />\n    <command_interface name=\"velocity\"
    />\n    <command_interface name=\"effort\" />\n    <state_interface name=\"position\"
    />\n    <state_interface name=\"velocity\" />\n    <state_interface name=\"effort\"
    />\n  </joint>\n  <transmission name=\"arm_5_trans\">\n    <plugin>transmission_interface/SimpleTransmission</plugin>\n   
    <actuator name=\"arm_5_actuator\" role=\"actuator1\" />\n    <joint name=\"arm_5_joint\"
    role=\"joint1\">\n      <mechanical_reduction>1.0</mechanical_reduction>\n     
    <offset>0.0</offset>\n    </joint>\n  </transmission>\n  <joint name=\"arm_6_joint\">\n   
    <command_interface name=\"position\" />\n    <command_interface name=\"velocity\"
    />\n    <command_interface name=\"effort\" />\n    <state_interface name=\"position\"
    />\n    <state_interface name=\"velocity\" />\n    <state_interface name=\"effort\"
    />\n  </joint>\n  <joint name=\"arm_7_joint\">\n    <command_interface name=\"position\"
    />\n    <command_interface name=\"velocity\" />\n    <command_interface name=\"effort\"
    />\n    <state_interface name=\"position\" />\n    <state_interface name=\"velocity\"
    />\n    <state_interface name=\"effort\" />\n  </joint>\n  <transmission name=\"arm_6_arm_7_wrist_trans\">\n   
    <plugin>transmission_interface/DifferentialTransmission</plugin>\n    <actuator
    name=\"arm_6_actuator\" role=\"actuator1\">\n      <mechanical_reduction>-1.0</mechanical_reduction>\n   
    </actuator>\n    <actuator name=\"arm_7_actuator\" role=\"actuator2\">\n     
    <mechanical_reduction>1.0</mechanical_reduction>\n    </actuator>\n    <joint
    name=\"arm_6_joint\" role=\"joint1\">\n      <mechanical_reduction>1.0</mechanical_reduction>\n     
    <offset>0.0</offset>\n    </joint>\n    <joint name=\"arm_7_joint\" role=\"joint2\">\n     
    <mechanical_reduction>-1.0</mechanical_reduction>\n      <offset>0.0</offset>\n   
    </joint>\n  </transmission>\n  <sensor name=\"wrist_ft_sensor\">\n    <state_interface
    name=\"force.x\" />\n    <state_interface name=\"force.y\" />\n    <state_interface
    name=\"force.z\" />\n    <state_interface name=\"torque.x\" />\n    <state_interface
    name=\"torque.y\" />\n    <state_interface name=\"torque.z\" />\n  </sensor>\n 
    <joint name=\"gripper_left_finger_joint\">\n    <command_interface name=\"position\"
    />\n    <state_interface name=\"position\" />\n    <state_interface name=\"velocity\"
    />\n    <state_interface name=\"effort\" />\n  </joint>\n  <transmission name=\"gripper_left_finger_trans\">\n   
