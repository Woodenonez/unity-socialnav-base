  PluginText: "<gazebo reference=\"base_footprint\">\n  <kp>100000000.0</kp>\n  <kd>10.0</kd>\n 
    <mu1>0.1</mu1>\n  <mu2>0.1</mu2>\n  <fdir1>1 0 0</fdir1>\n  <maxVel>10.0</maxVel>\n 
    <minDepth>0.0005</minDepth>\n  <laserRetro>0</laserRetro>\n</gazebo>"
--- !u!114 &4594180235372663704
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8222211471984596934}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.Robotics.UrdfImporter::Unity.Robotics.UrdfImporter.UrdfPlugin
  PluginText: "<gazebo>\n  <plugin filename=\"libgazebo_ros_planar_move.so\" name=\"gazebo_ros_planar_move\">\n   
    <ros>\n      <namespace></namespace>\n      <remapping>cmd_vel:=mobile_base_controller/cmd_vel_unstamped</remapping>\n     
    <remapping>odom:=mobile_base_controller/odom</remapping>\n    </ros>\n    <update_rate>100</update_rate>\n   
    <publish_rate>1000</publish_rate>\n    <publish_odom>true</publish_odom>\n   
    <publish_odom_tf>false</publish_odom_tf>\n    <odometry_frame>odom</odometry_frame>\n   
    <robot_base_frame>base_footprint</robot_base_frame>\n    <covariance_x>0.0001</covariance_x>\n   
    <covariance_y>0.0001</covariance_y>\n    <covariance_yaw>0.01</covariance_yaw>\n 
    </plugin>\n</gazebo>"
