--- !u!114 &2223086334189380314
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 179259031693416947}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.Robotics.UrdfImporter::Unity.Robotics.UrdfImporter.UrdfPlugin
  PluginText: "<gazebo>\n  <plugin filename=\"libgazebo_ros_p3d.so\" name=\"p3d_base_controller\">\n   
    <ros>\n      <namespace>mirX</namespace>\n      <remapping>odom:=odom_p3d</remapping>\n   
    </ros>\n    <always_on>true</always_on>\n    <update_rate>50.0</update_rate>\n   
    <body_name>mirX/base_footprint</body_name>\n    <gaussian_noise>0.01</gaussian_noise>\n   
    <frame_name>map</frame_name>\n    <topic_name>base_pose_ground_truth</topic_name>\n   
    <xyz_offset>0 0 0</xyz_offset>\n    <rpy_offset>0 0 0</rpy_offset>\n  </plugin>\n</gazebo>"
--- !u!114 &5206758151473621905
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 179259031693416947}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.Robotics.UrdfImporter::Unity.Robotics.UrdfImporter.UrdfPlugin
  PluginText: "<gazebo>\n  <plugin filename=\"libgazebo_ros_diff_drive.so\" name=\"diff_drive_controller\">\n   
    <ros>\n      <namespace>mirX</namespace>\n      <remapping>cmd_vel:=cmd_vel</remapping>\n     
    <remapping>odom:=odom</remapping>\n    </ros>\n    <legacy_mode>false</legacy_mode>\n   
    <always_on>true</always_on>\n    <update_rate>1000.0</update_rate>\n    <!--
    wheel joint -->\n    <left_joint>mirX/left_wheel_joint</left_joint>\n    <right_joint>mirX/right_wheel_joint</right_joint>\n   
    <!-- kinematics -->\n    <wheel_separation>0.445208</wheel_separation>\n    <wheel_diameter>0.125</wheel_diameter>\n   
    <wheel_torque>10</wheel_torque>\n    <wheel_acceleration>2.8</wheel_acceleration>\n   
    <!-- output -->\n    <odometry_frame>mirX/odom</odometry_frame>\n    <robot_base_frame>mirX/base_footprint</robot_base_frame>\n   
    <publish_tf>1</publish_tf>\n    <publish_wheel_tf>false</publish_wheel_tf>\n   
    <publish_wheel_joint_state>true</publish_wheel_joint_state>\n    <publish_odom>true</publish_odom>\n   
    <publish_odom_tf>true</publish_odom_tf>\n    <ros_debug_level>Debug</ros_debug_level>\n 
    </plugin>\n  <!-- <plugin name=\"mir_joint_state\" filename=\"libgazebo_ros_joint_state_publisher.so\">\n       
    <ros>\n          <namespace>${namespace}</namespace>\n          <remapping>~/out:=joint_states</remapping>\n       
    </ros>\n        <update_rate>30</update_rate>\n        <joint_name>${namespace}/${left_wheel_joint}</joint_name>\n       
    <joint_name>${namespace}/${right_wheel_joint}</joint_name>\n      </plugin>  
    -->\n</gazebo>"
