  <joint name="mirX/br_caster_wheel_joint" type="continuous">
    <origin rpy="0 0 0" xyz="-0.0382 0 -0.094"/>
    <parent link="mirX/br_caster_rotation_link"/>
    <child link="mirX/br_caster_wheel_link"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="mirX/br_caster_wheel_link">
    <inertial>
      <mass value="1.0"/>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <inertia ixx="0.001061895408575" ixy="0.0" ixz="0.0" iyy="0.001061895408575" iyz="0.0" izz="0.001953125"/>
    </inertial>
    <visual>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.032" radius="0.0625"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.032" radius="0.0625"/>
      </geometry>
    </collision>
  </link>
  <gazebo reference="mirX/br_caster_wheel_link">
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <joint name="mirX/base_link_surface_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.037646 0 0.352"/>
    <parent link="mirX/base_link"/>
    <child link="mirX/surface"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="mirX/surface"/>
  <transmission name="mirX/left_wheel_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="mirX/left_wheel_joint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="mirX/left_wheel_motor">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="mirX/right_wheel_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="mirX/right_wheel_joint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="mirX/right_wheel_motor">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <gazebo reference="mirX/left_wheel_link">
    <mu1 value="200"/>
    <mu2 value="200"/>
    <kp value="10000000.0"/>
    <kd value="1.0"/>
    <min_depth>0.01</min_depth>
  </gazebo>
  <gazebo reference="mirX/right_wheel_link">
    <mu1 value="200"/>
    <mu2 value="200"/>
    <kp value="10000000.0"/>
    <kd value="1.0"/>
    <min_depth>0.01</min_depth>
  </gazebo>
  <gazebo reference="mirX/fl_caster_wheel_link">
    <mu1 value="1"/>
    <mu2 value="1"/>
    <kp value="10000000.0"/>
    <kd value="1.0"/>
    <min_depth>0.01</min_depth>
  </gazebo>
  <gazebo reference="mirX/fr_caster_wheel_link">
    <mu1 value="1"/>
    <mu2 value="1"/>
    <kp value="10000000.0"/>
    <kd value="1.0"/>
    <min_depth>0.01</min_depth>
  </gazebo>
  <gazebo reference="mirX/bl_caster_wheel_link">
    <mu1 value="1"/>
    <mu2 value="1"/>
    <kp value="10000000.0"/>
    <kd value="1.0"/>
    <min_depth>0.01</min_depth>
  </gazebo>
  <gazebo reference="mirX/br_caster_wheel_link">
    <mu1 value="1"/>
    <mu2 value="1"/>
    <kp value="10000000.0"/>
    <kd value="1.0"/>
    <min_depth>0.01</min_depth>
  </gazebo>
  <!-- pose3d: simulates a GPS and/or IMU-like sensor -->
  <gazebo>
    <plugin filename="libgazebo_ros_p3d.so" name="p3d_base_controller">
      <ros>
        <namespace>mirX</namespace>
        <remapping>odom:=odom_p3d</remapping>
      </ros>
      <always_on>true</always_on>
      <update_rate>50.0</update_rate>
      <body_name>mirX/base_footprint</body_name>
      <gaussian_noise>0.01</gaussian_noise>
      <frame_name>map</frame_name>
      <topic_name>base_pose_ground_truth</topic_name>
      <xyz_offset>0 0 0</xyz_offset>
      <rpy_offset>0 0 0</rpy_offset>
    </plugin>
  </gazebo>
  <!-- Footprint -->
  <link name="mirX/base_footprint"/>
  <joint name="mirX/base_joint" type="fixed">
    <parent link="mirX/base_footprint"/>
    <child link="mirX/base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <!-- Controller option 1: Gazebo controller plugin -->
  <!-- <xacro:controller_plugin_gazebo robot_namespace=$(arg namespace)/> -->
  <gazebo>
    <plugin filename="libgazebo_ros_diff_drive.so" name="diff_drive_controller">
      <ros>
        <namespace>mirX</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <legacy_mode>false</legacy_mode>
      <always_on>true</always_on>
      <update_rate>1000.0</update_rate>
      <!-- wheel joint -->
      <left_joint>mirX/left_wheel_joint</left_joint>
      <right_joint>mirX/right_wheel_joint</right_joint>
      <!-- kinematics -->
      <wheel_separation>0.445208</wheel_separation>
      <wheel_diameter>0.125</wheel_diameter>
      <wheel_torque>10</wheel_torque>
      <wheel_acceleration>2.8</wheel_acceleration>
      <!-- output -->
      <odometry_frame>mirX/odom</odometry_frame>
      <robot_base_frame>mirX/base_footprint</robot_base_frame>
      <publish_tf>1</publish_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <publish_wheel_joint_state>true</publish_wheel_joint_state>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <ros_debug_level>Debug</ros_debug_level>
    </plugin>
    <!-- <plugin name="mir_joint_state" filename="libgazebo_ros_joint_state_publisher.so">
        <ros>
          <namespace>${namespace}</namespace>
          <remapping>~/out:=joint_states</remapping>
        </ros>
        <update_rate>30</update_rate>
        <joint_name>${namespace}/${left_wheel_joint}</joint_name>
        <joint_name>${namespace}/${right_wheel_joint}</joint_name>
      </plugin>   -->
  </gazebo>
</robot>
